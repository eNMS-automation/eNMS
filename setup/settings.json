{
  "app": {
    "name": "eNMS",
    "config_mode": "debug",
    "documentation_url": "https://enms.readthedocs.io/en/latest/",
    "git_repository": "git@github.com:afourmy/gitpython-test.git",
    "max_content_length": 104857600,
    "plugin_path": "eNMS/plugins",
    "profiling": false,
    "session_timeout_minutes": 30,
    "startup_migration": "examples",
    "theme": "default",
    "version": 5.1
  },
  "on_startup": {
    "get_git_content": false,
    "scan_folder": false
  },
  "authentication": {
    "default": "database",
    "landing_page": "/dashboard",
    "allow_password_change": true,
    "force_authentication_method": false,
    "duo": {
      "config": {
        "client_id": "DIRUY3ZRHXYYHVOZDMIW",
        "host": "api-58bbe24c.duosecurity.com",
        "redirect_uri": "https://enms:5000/duo-callback"
      },
      "enabled": false
    },
    "methods": {
      "database": {
        "display_name": "Local User",
        "enabled": true
      },
      "ldap": {
        "display_name": "LDAP",
        "enabled": true,
        "servers": {
          "192.168.56.104": {
            "port": 636,
            "use_ssl": true
          }
        }
      },
      "tacacs": {
        "display_name": "TACACS+",
        "enabled": true
      }
    }
  },
  "automation": {
    "max_process": 50,
    "task_queue": false
  },
  "cache": {
    "config": {
      "CACHE_TYPE": "SimpleCache"
    },
    "timeout": 500
  },
  "cluster": {
    "allowed_automation": ["scheduler", "rest_api", "application"],
    "active": false,
    "id": true,
    "scan_protocol": "http",
    "scan_subnet": "192.168.105.0/24",
    "scan_timeout": 0.05
  },
  "dashboard": {
    "label": {
      "normal": {
        "formatter": "{b} ({c})"
      }
    },
    "series": [
      {
        "type": "pie"
      }
    ],
    "tooltip": {
      "formatter": "{b} : {c} ({d}%)"
    }
  },
  "docs": {
    "administration": "base/installation/",
    "changelog_table": "system/changelog/",
    "configuration_table": "inventory/configuration_management/",
    "credential_table": "administration/credentials/",
    "dashboard": "system/dashboard/",
    "device_table": "inventory/network_creation/",
    "file_table": "system/files/",
    "geographical_view": "visualization/geographical_view/",
    "link_table": "inventory/links/",
    "network_builder": "visualization/network_builder/",
    "network_table": "visualization/network_builder/",
    "pool_table": "inventory/pools/",
    "run_table": "automation/results/",
    "service_table": "automation/services/",
    "session_table": "system/sessions/",
    "task_table": "automation/scheduling/",
    "user_table": "administration/users/",
    "workflow_builder": "automation/workflow_builder/"
  },
  "files": {
    "delete_if_not_found": true,
    "ignored_types": [".swp", ".tgz", "yaml"],
    "polling_interval": 1,
    "upload_timeout": 600000,
    "log_events": true,
    "trash": ""
  },
  "mail": {
    "port": 587,
    "reply_to": "antoine.fourmy@gmail.com",
    "sender": "antoine.fourmy@gmail.com",
    "server": "smtp.googlemail.com",
    "use_tls": true,
    "username": "antoine.fourmy@gmail.com"
  },
  "mattermost": {
    "channel": "",
    "url": "https://mattermost.company.com/hooks/i1phfh6fxjfwpy586bwqq5sk8w",
    "verify_certificate": true
  },
  "notification_banner": {
    "active": false,
    "deactivate_on_restart": true,
    "properties": {
      "autoclose": "30s",
      "content": "<center>The Server is <b>restarting at 3:30 UTC.</b><br>Contact <b>adress@domain.com</b> for more information.</center>",
      "contentSize": "600 auto",
      "header": false,
      "opacity": 0.85,
      "position": "center-bottom 0 -10 up",
      "theme": "danger filleddark"
    }
  },
  "paths": {
    "custom_code": "",
    "custom_datastore": "",
    "custom_devices": "",
    "custom_links": "",
    "custom_services": "",
    "files": "",
    "migration": "",
    "playbooks": ""
  },
  "pool": {
    "fast_compute": true
  },
  "rate_limiter": {
    "requests": {
      "global": {
        "window_size": 60,
        "max_requests": 50
      },
      "rest": {
        "window_size": 60,
        "max_requests": 6,
        "rest_api": true
      }
    },
    "runs": 5
  },
  "redis": {
    "config": {
      "db": 0,
      "decode_responses": true,
      "port": 6379,
      "socket_timeout": 0.1
    },
    "flush_on_restart": true
  },
  "requests": {
    "pool": {
      "pool_block": false,
      "pool_connections": 10,
      "pool_maxsize": 100
    },
    "retries": {
      "backoff_factor": 0.5,
      "connect": 2,
      "read": 2,
      "total": 2
    }
  },
  "security": {
    "forbidden_python_libraries": ["eNMS", "os", "subprocess", "sys"]
  },
  "slack": {
    "channel": "random"
  },
  "ssh": {
    "bypass_key_prompt": true,
    "command": "/home/afourmy/venvs/venv/bin/python3 -m flask run -h 0.0.0.0",
    "credentials": {
      "custom": true,
      "named": true,
      "device": true
    },
    "end_port": 9100,
    "port": -1,
    "port_redirection": false,
    "start_port": 9000,
    "web": {
      "CORS_ALLOWED_ORIGINS": "*",
      "LC_ALL": "en_US.utf-8",
      "VERIFY_CERTIFICATE": false
    }
  },
  "tables": {
    "refresh": {
      "file": 3000,
      "run": 5000,
      "service": 3000,
      "task": 3000
    },
    "search": {
      "notification": false,
      "timer": 300
    }
  },
  "vault": {
    "mount": ["http://", "https://"],
    "pool_maxsize": 25,
    "retry": {
      "total": 2,
      "backoff_factor": 0.2,
      "status_forcelist": [408, 412, 429, 500, 502, 503, 504],
      "raise_on_status": false
    },
    "unseal_vault": false,
    "use_vault": false
  }
}
